---
import StorySection from './StorySection.astro';
const { sections, layout = 'side-by-side' } = Astro.props;
---
<div class:list={['scrollytelling', { 'scrollytelling--stacked': layout === 'stacked' }]} data-scrollytelling>
  {sections.map((section, index) => <StorySection section={section} index={index} />)}
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-scrollytelling]')) {
    // Stacked stories use normal document scrolling without chart tracking.
    if (root.classList.contains('scrollytelling--stacked')) continue;
    const steps = [...root.querySelectorAll<HTMLElement>('[data-story-step]')];
    const headers = document.querySelector<HTMLElement>('[data-scrolling-headers]');
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const desktop = matchMedia('(min-width: 901px)');
    const slots = steps.map(step => step.querySelector<HTMLElement>('[data-chart-slot]')!);

    function updateChartFit() {
      const chromeHeight = headers?.offsetHeight ?? 154;
      const available = window.innerHeight - chromeHeight - 32;
      slots.forEach(slot => {
        const height = slot.offsetHeight;
        slot.style.setProperty('--active-chart-height', `${height}px`);
        slot.toggleAttribute('data-tall', height > available);
      });
    }
    // Keep every embed in its section and visible to Flourish's responsive loader.
    // No reparenting or display:none initialization at a zero-width container.
    const resizeObserver = new ResizeObserver(updateChartFit);
    slots.forEach(slot => resizeObserver.observe(slot));
    if (headers) resizeObserver.observe(headers);
    window.addEventListener('resize', updateChartFit, { passive: true });
    updateChartFit();

    let current = -1;
    const observer = new IntersectionObserver(() => {
      const readingLine = window.innerHeight * 0.45;
      let next = 0;
      steps.forEach((step, index) => {
        if (step.getBoundingClientRect().top <= readingLine) next = index;
      });
      if (next === current) return;
      current = next;
      steps.forEach((step, index) => step.toggleAttribute('data-active', index === current));
      if (desktop.matches && !reducedMotion.matches) {
        const chart = slots[current]?.querySelector<HTMLElement>('[data-chart-panel]');
        chart?.getAnimations().forEach(animation => animation.cancel());
        chart?.animate([{ opacity: 0.65 }, { opacity: 1 }], { duration: 220, easing: 'ease-out' });
      }
    }, { rootMargin: '-44% 0px -55% 0px', threshold: 0 });
    steps.forEach(step => observer.observe(step));
  }
</script>
