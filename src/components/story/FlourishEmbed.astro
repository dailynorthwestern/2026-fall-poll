---
const { section, index } = Astro.props;
// Accept numeric IDs or public Flourish visualization / embed URLs.
let id = section.flourishId ? String(section.flourishId).trim() : null;
if (!id && section.flourishUrl) {
  const url = new URL(section.flourishUrl);
  if (!['public.flourish.studio', 'flo.uri.sh', 'app.flourish.studio'].includes(url.hostname)) {
    throw new Error(`Unsupported Flourish URL in section ${section.id}`);
  }
  id = url.pathname.match(/\/visualisation\/(\d+)/)?.[1] ?? null;
}
if ((id && !/^\d+$/.test(id)) || (section.flourishUrl && !id)) {
  throw new Error(`Invalid Flourish visualization in section ${section.id}`);
}

---
<figure class="story-chart" data-chart-panel data-index={index} aria-label={section.subheading}>
  {id ? (
    <div class="flourish-embed" data-src={`visualisation/${id}`}>
      <noscript><a href={`https://public.flourish.studio/visualisation/${id}/`}>View this visualization on Flourish</a></noscript>
    </div>
  ) : (
    <div class="chart-placeholder">
      <p>Visualization placeholder</p>
      <p>Flourish chart for this section has not been supplied.</p>
    </div>
  )}
</figure>

<script>
  import { initializeVisibleFlourish } from '../../scripts/flourish';
  void initializeVisibleFlourish();
</script>
