---
import FlourishEmbed from './FlourishEmbed.astro';
const { sections } = Astro.props;
---
<div class="persistent-story" data-persistent-story>
  <div class="persistent-copy-list">
    {sections.map((section, index) => (
      <section class="persistent-step" id={section.id} data-persistent-step style={`--section-order: ${index * 2}`} aria-labelledby={`${section.id}-heading`}>
        <div class="story-copy">
          <h2 id={`${section.id}-heading`}>{section.subheading}</h2>
          {section.paragraphs.map(paragraph => <p>{typeof paragraph === 'string' ? paragraph : paragraph.map(part => typeof part === 'string' ? part : <a href={part.href}>{part.text}</a>)}</p>)}
        </div>
      </section>
    ))}
  </div>
  <div class="persistent-chart-rail">
    <div class="persistent-chart-stage">
      {sections.map((section, index) => (
        <div class="persistent-chart" data-persistent-chart style={`--section-order: ${index * 2 + 1}`}>
          <FlourishEmbed section={section} index={index} />
        </div>
      ))}
    </div>
  </div>
</div>
<script>
  import { initializePersistentStories } from '../../scripts/persistent-story';
  initializePersistentStories();
</script>
