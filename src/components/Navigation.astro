---
import { navigation, pageUrl } from '../data/navigation.js';
const currentPath = Astro.url.pathname.replace(/\/$/, '');
---
<nav class="site-navigation" aria-label="Main navigation">
  <ul class="shell navigation-list">
    {navigation.map(({ title, slug, href }) => (
      <li><a href={href ?? pageUrl(slug)} target={href ? '_blank' : undefined} rel={href ? 'noopener noreferrer' : undefined} aria-current={!href && currentPath === pageUrl(slug).replace(/\/$/, '') ? 'page' : undefined}>{title}</a></li>
    ))}
  </ul>
</nav>

<style lang="scss">
  .site-navigation {
    --nav-padding-y: 5px;
    --nav-item-gap: clamp(12px, 1.5vw, 28px);
    --nav-side-padding: clamp(16px, 3vw, 48px);
    background: var(--white);
    color: var(--poll-dark-brown);
    border-bottom: 1px solid var(--poll-peach);
    box-shadow: 0 3px 7px rgb(87 52 37 / 8%);
    font-family: var(--font-secondary);
    font-style: normal;
    position: relative;
    z-index: 30;
  }
  .navigation-list {
    width: 100%;
    max-width: none;
    overflow-x: auto;
    scrollbar-width: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: nowrap;
    gap: var(--nav-item-gap);
    list-style: none;
    padding: var(--nav-padding-y) var(--nav-side-padding);
    margin-block: 0;
  }
  .navigation-list::-webkit-scrollbar { display: none; }
  li { flex-shrink: 0; }
  a {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-size: clamp(1rem, 1.6vw, 1.4rem);
    font-weight: 400;
    line-height: 1.25;
    text-decoration: none;
    white-space: nowrap;
  }
  a:hover, a[aria-current="page"], a:focus-visible { color: var(--poll-dark-red); }
  @media (max-width: 600px) {
    .site-navigation { --nav-item-gap: 14px; }
    a { font-size: 0.9rem; }
  }
</style>
