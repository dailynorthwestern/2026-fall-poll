---
import PollLayout from './PollLayout.astro';
import StoryIntroduction from '../components/story/StoryIntroduction.astro';
import Scrollytelling from '../components/story/Scrollytelling.astro';
import '../styles/story.scss';
const { story, sectionLayout = 'side-by-side' } = Astro.props;
---
<PollLayout title={`${story.topic} | 2026 Fall Poll`}>
  <article class="shell poll-story">
    <StoryIntroduction {...story} />
    <Scrollytelling sections={story.sections} layout={sectionLayout} />
  </article>
</PollLayout>
